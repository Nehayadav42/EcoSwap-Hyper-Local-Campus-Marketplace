MONGODB_URI=mongodb://Neha_Yadav:EcoSwapEcoSwap@ac-2ifgghz-shard-00-00.juqsznc.mongodb.net:27017,ac-2ifgghz-shard-00-01.juqsznc.mongodb.net:27017,ac-2ifgghz-shard-00-02.juqsznc.mongodb.net:27017/test?ssl=true&replicaSet=atlas-rvyegf-shard-0&authSource=admin&appName=EcoSwap

